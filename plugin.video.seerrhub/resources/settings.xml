<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
  <category label="Seerr">
    <setting id="seerr_url" type="text" label="Seerr address (http://ip:5055)" default=""/>
    <setting id="api_key" type="text" option="hidden" label="Seerr API key" default=""/>
    <setting id="region" type="text" label="Streaming region (blank = from Seerr)" default=""/>
  </category>
  <category label="Media server">
    <setting id="media_server" type="enum" label="Media server" values="Ask Seerr|Plex|Jellyfin|Emby|None" default="0"/>
    <setting type="lsep" label="Jellyfin / Emby (blank = use their Kodi add-on login)"/>
    <setting id="server_url" type="text" label="Server address (http://ip:8096)" default=""/>
    <setting id="server_key" type="text" option="hidden" label="API key" default=""/>
    <setting id="server_user" type="text" label="User name" default=""/>
  </category>
  <category label="Downloads">
    <setting type="lsep" label="Torrent client (optional: blank = Radarr/Sonarr's queue, no watching while it downloads)"/>
    <setting id="dl_client" type="enum" label="Client" values="qBittorrent|Transmission|Deluge" default="0"/>
    <setting id="dl_url" type="text" label="Web UI address (qBittorrent :8080, Transmission :9091, Deluge :8112)" default=""/>
    <setting id="dl_user" type="text" label="User name (blank if none; Deluge has none)" default="" visible="!eq(-2,2)"/>
    <setting id="dl_pass" type="text" option="hidden" label="Password (Deluge: blank = deluge)" default=""/>
    <setting id="downloads_path" type="text" label="Download folder as Kodi sees it (smb://nas/downloads/)" default=""/>
    <setting id="qbit_url" type="text" label="" default="" visible="false"/>
    <setting id="qbit_user" type="text" label="" default="" visible="false"/>
    <setting id="qbit_pass" type="text" label="" default="" visible="false"/>
  </category>
</settings>
